DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/dashy?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/dashy?sslmode=require&channel_binding=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Single-Owner Access Control (Not SaaS)
# Set your authorized owner email address here.
OWNER_EMAIL="owner@example.com"
# High-entropy token used during initial one-time owner bootstrap (generate with openssl rand -hex 32)
OWNER_BOOTSTRAP_TOKEN=""

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: production must use a SEPARATE secret set in Vercel — never the local value.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile (free): https://dash.cloudflare.com → Turnstile → add a widget.
# Site key is public (NEXT_PUBLIC_), secret key is server-only.
# For local dev you may use Cloudflare's always-pass test keys:
#   site   = 1x00000000000000000000AA
#   secret = 1x0000000000000000000000000000000AA
# Note: When using these dummy test keys, Cloudflare intentionally displays a visual
# banner: "For testing only. If seen, report to site owner." To remove this in production,
# create a real Turnstile widget in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Resend (free): https://resend.com → API Keys. EMAIL_FROM needs a verified domain
# (e.g. "Dashy <noreply@yourdomain.com>"). Leave blank until a domain is verified —
# email is logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# Flip to "true" only once EMAIL_FROM points at a verified domain and real delivery works.
EMAIL_VERIFICATION_ENABLED="false"

# PostHog product analytics (free tier): https://posthog.com → project settings.
# Leave blank to disable analytics entirely (all tracking calls no-op).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Multi-Provider AI Assistant Configuration
# Gemini (Google GenAI SDK): https://aistudio.google.com
GEMINI_API_KEY=""
# OpenAI SDK: https://platform.openai.com
OPENAI_API_KEY=""
# Anthropic Claude SDK: https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Default model: e.g. "gemini-2.5-flash", "gpt-4o-mini", "claude-3-5-sonnet"
AI_DEFAULT_MODEL="gemini-2.5-flash"
# Hard monthly spending cap in USD
AI_MONTHLY_BUDGET_USD="20.00"
