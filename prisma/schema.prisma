generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkStatus {
  IDEA
  PLANNED
  ACTIVE
  WAITING
  DONE
  ARCHIVED
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum FinanceType {
  INCOME
  EXPENSE
  INVESTMENT
  SAVING
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  TASK_DUE
  DEADLINE
  REMINDER
  SUBSCRIPTION_RENEWAL
  DOMAIN_EXPIRY
  MEETING
  DAILY_REVIEW
  GOAL
}

model User {
  id               String               @id @default(cuid())
  name             String
  email            String               @unique
  emailVerified    Boolean              @default(false)
  image            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         Session[]
  accounts         Account[]
  settings         UserSettings?
  projects         Project[]
  tasks            Task[]
  milestones       Milestone[]
  notes            Note[]
  knowledgePages   KnowledgePage[]
  ideas            Idea[]
  documents        Document[]
  files            FileAsset[]
  calendarEvents   CalendarEvent[]
  goals            Goal[]
  habits           Habit[]
  journalEntries   JournalEntry[]
  learningItems    LearningItem[]
  courses          Course[]
  resources        Resource[]
  transactions     FinanceTransaction[]
  budgets          Budget[]
  subscriptions    Subscription[]
  crmLeads         CrmLead[]
  schools          School[]
  ngoProjects      NgoProject[]
  volunteers       Volunteer[]
  beneficiaries    Beneficiary[]
  contacts         Contact[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  comments         Comment[]
  workSessions     WorkSession[]
  pomodoroSessions PomodoroSession[]
  tags             Tag[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth rate-limit storage (storage: "database"). Kept in the schema's
// PascalCase convention — no @@map — to match the other auth tables.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                String   @default("system")
  notificationsEnabled Boolean  @default(true)
  keyboardShortcuts    Json?
  connectedAccounts    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String        @id @default(cuid())
  userId           String
  title            String
  description      String?
  color            String?
  icon             String?
  status           WorkStatus    @default(PLANNED)
  previousStatus   WorkStatus?
  priority         Priority      @default(MEDIUM)
  startDate        DateTime?
  deadline         DateTime?
  progress         Int           @default(0)
  githubRepository String?
  website          String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks            Task[]
  milestones       Milestone[]
  notes            Note[]
  files            FileAsset[]
  goals            Goal[]
  activityLogs     ActivityLog[]
  comments         Comment[]
  tags             Tag[]         @relation("ProjectTags")

  @@index([userId, status])
  @@index([deadline])
}

model Milestone {
  id          String     @id @default(cuid())
  userId      String
  projectId   String
  title       String
  description String?
  status      WorkStatus @default(PLANNED)
  dueDate     DateTime?
  progress    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id               String              @id @default(cuid())
  userId           String
  projectId        String?
  parentId         String?
  title            String
  description      String?
  status           WorkStatus          @default(PLANNED)
  previousStatus   WorkStatus?
  priority         Priority            @default(MEDIUM)
  dueDate          DateTime?
  reminderAt       DateTime?
  recurrence       RecurrenceFrequency @default(NONE)
  estimatedMinutes Int?
  actualMinutes    Int?
  progress         Int                 @default(0)
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent           Task?               @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         Task[]              @relation("TaskSubtasks")
  dependencies     TaskDependency[]    @relation("TaskDependencySource")
  dependents       TaskDependency[]    @relation("TaskDependencyTarget")
  files            FileAsset[]
  comments         Comment[]
  tags             Tag[]               @relation("TaskTags")

  @@index([userId, status])
  @@index([projectId])
  @@index([dueDate])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskDependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model CalendarEvent {
  id          String              @id @default(cuid())
  userId      String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  recurrence  RecurrenceFrequency @default(NONE)
  reminderAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([userId, startsAt])
}

model KnowledgePage {
  id         String          @id @default(cuid())
  userId     String
  parentId   String?
  title      String
  slug       String
  content    String?
  summary    String?
  isFavorite Boolean         @default(false)
  isPinned   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     KnowledgePage?  @relation("KnowledgeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   KnowledgePage[] @relation("KnowledgeHierarchy")
  versions   PageVersion[]
  notes      Note[]
  tags       Tag[]           @relation("KnowledgeTags")

  @@unique([userId, slug])
  @@index([parentId])
}

model PageVersion {
  id              String        @id @default(cuid())
  knowledgePageId String
  content         String
  createdAt       DateTime      @default(now())
  knowledgePage   KnowledgePage @relation(fields: [knowledgePageId], references: [id], onDelete: Cascade)
}

model Note {
  id              String         @id @default(cuid())
  userId          String
  projectId       String?
  eventId         String?
  knowledgePageId String?
  title           String
  content         String?
  folder          String?
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  event           CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  knowledgePage   KnowledgePage? @relation(fields: [knowledgePageId], references: [id], onDelete: SetNull)
  outgoingLinks   NoteLink[]     @relation("SourceNote")
  incomingLinks   NoteLink[]     @relation("TargetNote")
  files           FileAsset[]
  tags            Tag[]          @relation("NoteTags")

  @@index([userId, updatedAt])
}

model NoteLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  createdAt DateTime @default(now())
  source    Note     @relation("SourceNote", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Note     @relation("TargetNote", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model Idea {
  id             String     @id @default(cuid())
  userId         String
  title          String
  description    String?
  category       String?
  status         WorkStatus @default(IDEA)
  priority       Priority   @default(MEDIUM)
  potentialValue Int?
  relatedProject String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           Tag[]      @relation("IdeaTags")
}

model Document {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  folder      String?
  type        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       FileAsset[]
  versions    FileVersion[]
  tags        Tag[]         @relation("DocumentTags")
}

model FileAsset {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  taskId     String?
  noteId     String?
  documentId String?
  name       String
  url        String
  mimeType   String?
  size       Int?
  checksum   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note       Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

model FileVersion {
  id         String   @id @default(cuid())
  documentId String
  url        String
  version    Int
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Goal {
  id           String          @id @default(cuid())
  userId       String
  projectId    String?
  title        String
  description  String?
  period       GoalPeriod
  progress     Int             @default(0)
  targetValue  Int?
  currentValue Int             @default(0)
  startsAt     DateTime?
  dueDate      DateTime?
  status       WorkStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestones   GoalMilestone[]
  tags         Tag[]           @relation("GoalTags")
}

model GoalMilestone {
  id        String    @id @default(cuid())
  goalId    String
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Habit {
  id            String              @id @default(cuid())
  userId        String
  title         String
  description   String?
  frequency     RecurrenceFrequency @default(DAILY)
  currentStreak Int                 @default(0)
  longestStreak Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(false)
  value     Int?
  notes     String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  wins         String?
  problems     String?
  lessons      String?
  ideas        String?
  mood         String?
  tomorrowPlan String?
  summary      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Course {
  id             String         @id @default(cuid())
  userId         String
  title          String
  provider       String?
  category       String?
  progress       Int            @default(0)
  certificateUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItems  LearningItem[]
}

model Resource {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String?
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningItem {
  id          String     @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  description String?
  category    String?
  status      WorkStatus @default(PLANNED)
  progress    Int        @default(0)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tags        Tag[]      @relation("LearningTags")
}

model FinanceTransaction {
  id          String      @id @default(cuid())
  userId      String
  type        FinanceType
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("USD")
  category    String
  description String?
  occurredAt  DateTime
  recurring   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  spent     Decimal  @default(0) @db.Decimal(12, 2)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  renewalDate DateTime
  category    String?
  url         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrmLead {
  id           String    @id @default(cuid())
  userId       String
  name         String
  company      String?
  email        String?
  phone        String?
  status       String    @default("Interested")
  value        Decimal?  @db.Decimal(12, 2)
  notes        String?
  nextFollowUp DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id             String    @id @default(cuid())
  userId         String
  name           String
  principal      String?
  contactPerson  String?
  email          String?
  phone          String?
  location       String?
  demoStatus     String?
  proposalStatus String?
  followUpAt     DateTime?
  meetingNotes   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NgoProject {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  status        WorkStatus    @default(PLANNED)
  budget        Decimal?      @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteers    Volunteer[]
  beneficiaries Beneficiary[]
}

model Volunteer {
  id           String      @id @default(cuid())
  userId       String
  ngoProjectId String?
  name         String
  email        String?
  phone        String?
  role         String?
  attendance   Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoProject   NgoProject? @relation(fields: [ngoProjectId], references: [id], onDelete: SetNull)
}

model Beneficiary {
  id           String      @id @default(cuid())
  userId       String
  ngoProjectId String?
  name         String
  phone        String?
  location     String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoProject   NgoProject? @relation(fields: [ngoProjectId], references: [id], onDelete: SetNull)
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  email     String?
  company   String?
  role      String?
  address   String?
  notes     String?
  history   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]    @relation("ContactTags")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  dueAt     DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  taskId    String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  minutes   Int?
  notes     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PomodoroSession {
  id        String    @id @default(cuid())
  userId    String
  minutes   Int
  completed Boolean   @default(false)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id             String          @id @default(cuid())
  userId         String
  name           String
  color          String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]       @relation("ProjectTags")
  tasks          Task[]          @relation("TaskTags")
  knowledgePages KnowledgePage[] @relation("KnowledgeTags")
  notes          Note[]          @relation("NoteTags")
  ideas          Idea[]          @relation("IdeaTags")
  documents      Document[]      @relation("DocumentTags")
  goals          Goal[]          @relation("GoalTags")
  learningItems  LearningItem[]  @relation("LearningTags")
  contacts       Contact[]       @relation("ContactTags")

  @@unique([userId, name])
}
