generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkStatus {
  IDEA
  PLANNED
  ACTIVE
  WAITING
  DONE
  ARCHIVED
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum FinanceType {
  INCOME
  EXPENSE
  INVESTMENT
  SAVING
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStage {
  LEAD
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum JobStatus {
  SAVED
  APPLIED
  SCREENING
  TECHNICAL
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  TASK_DUE
  DEADLINE
  REMINDER
  SUBSCRIPTION_RENEWAL
  DOMAIN_EXPIRY
  MEETING
  DAILY_REVIEW
  GOAL
}

// ----------------------------------------------------
// AUTHENTICATION & SINGLE-OWNER ACCESS
// ----------------------------------------------------

model User {
  id                 String                @id @default(cuid())
  name               String
  email              String                @unique
  emailVerified      Boolean               @default(false)
  image              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  sessions           Session[]
  accounts           Account[]
  settings           UserSettings?
  workspaces         Workspace[]
  projects           Project[]
  tasks              Task[]
  milestones         Milestone[]
  notes              Note[]
  knowledgePages     KnowledgePage[]
  ideas              Idea[]
  documents          Document[]
  files              FileAsset[]
  calendarEvents     CalendarEvent[]
  goals              Goal[]
  habits             Habit[]
  journalEntries     JournalEntry[]
  learningItems      LearningItem[]
  courses            Course[]
  resources          Resource[]
  transactions       FinanceTransaction[]
  budgets            Budget[]
  subscriptions      Subscription[]
  crmLeads           CrmLead[]
  schools            School[]
  ngoProjects        NgoProject[]
  volunteers         Volunteer[]
  beneficiaries      Beneficiary[]
  contacts           Contact[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  comments           Comment[]
  workSessions       WorkSession[]
  pomodoroSessions   PomodoroSession[]
  tags               Tag[]
  jobApplications    JobApplication[]
  aiConversations    AiConversation[]
  aiUsageLogs        AiUsageLog[]
  confirmationTokens AiConfirmationToken[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth rate-limit storage (storage: "database")
model RateLimit {
  id          String  @id @default(cuid())
  key         String  @unique
  count       Int     @default(0)
  lastRequest BigInt?
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                String   @default("system")
  notificationsEnabled Boolean  @default(true)
  keyboardShortcuts    Json?
  connectedAccounts    Json?
  activeWorkspaceId    String?
  revenueGoalAmount    Decimal  @default(1000000) @db.Decimal(12, 2)
  revenueGoalMetric    String   @default("COLLECTED_REVENUE") // COLLECTED_REVENUE | NET_PROFIT
  dailyBriefingTime    String   @default("08:30")
  lastBriefingDate     String?
  aiMonthlyBudgetUsd   Decimal  @default(10.00) @db.Decimal(6, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// THE 5 WORKSPACES
// ----------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  slug        String   // freelance-software | dkom | diamond-jewellers | mithila-kritikala | personal
  name        String   // Freelance & Software Development | DKOM | Diamond Jewellers | Mithila KritiKala | Personal
  description String?
  color       String?
  icon        String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects     Project[]
  tasks        Task[]
  clients      Client[]
  transactions FinanceTransaction[]
  invoices     Invoice[]
  documents    Document[]
  notes        Note[]
  noteFolders  NoteFolder[]
  events       CalendarEvent[]

  @@unique([userId, slug])
  @@index([userId])
}

// ----------------------------------------------------
// TASKS & SUBTASKS
// ----------------------------------------------------

model Task {
  id               String              @id @default(cuid())
  userId           String
  workspaceId      String?
  projectId        String?
  parentId         String?
  title            String
  description      String?
  status           WorkStatus          @default(PLANNED)
  previousStatus   WorkStatus?
  priority         Priority            @default(MEDIUM)
  dueDate          DateTime?
  reminderAt       DateTime?
  recurrence       RecurrenceFrequency @default(NONE)
  estimatedMinutes Int?
  actualMinutes    Int?
  progress         Int                 @default(0)
  kanbanOrder      Int                 @default(0)
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent           Task?               @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         Task[]              @relation("TaskSubtasks")
  dependencies     TaskDependency[]    @relation("TaskDependencySource")
  dependents       TaskDependency[]    @relation("TaskDependencyTarget")
  files            FileAsset[]
  comments         Comment[]
  tags             Tag[]               @relation("TaskTags")

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([projectId])
  @@index([dueDate])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskDependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

// ----------------------------------------------------
// PROJECTS & MILESTONES
// ----------------------------------------------------

model Project {
  id               String        @id @default(cuid())
  userId           String
  workspaceId      String?
  title            String
  description      String?
  color            String?
  icon             String?
  status           WorkStatus    @default(PLANNED)
  previousStatus   WorkStatus?
  priority         Priority      @default(MEDIUM)
  startDate        DateTime?
  deadline         DateTime?
  progress         Int           @default(0)
  blockers         String?
  nextAction       String?
  githubRepository String?
  website          String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks            Task[]
  milestones       Milestone[]
  notes            Note[]
  documents        Document[]
  files            FileAsset[]
  goals            Goal[]
  activityLogs     ActivityLog[]
  comments         Comment[]
  tags             Tag[]         @relation("ProjectTags")

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([deadline])
}

model Milestone {
  id          String     @id @default(cuid())
  userId      String?
  projectId   String
  title       String
  description String?
  status      WorkStatus @default(PLANNED)
  dueDate     DateTime?
  progress    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ----------------------------------------------------
// CLIENT CRM
// ----------------------------------------------------

model Client {
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  company        String?
  email          String?
  phone          String?
  leadSource     String?
  dealValue      Decimal?            @default(0) @db.Decimal(12, 2)
  stage          LeadStage           @default(LEAD)
  lostReason     String?
  nextFollowUpAt DateTime?
  requirements   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interactions   ClientInteraction[]
  invoices       Invoice[]
  transactions   FinanceTransaction[]
  documents      Document[]
  notes          Note[]

  @@index([workspaceId, stage])
  @@index([nextFollowUpAt])
}

model ClientInteraction {
  id            String    @id @default(cuid())
  clientId      String
  type          String    // CALL | EMAIL | MEETING | WHATSAPP | NOTE
  summary       String
  interactionAt DateTime  @default(now())
  followUpAt    DateTime?
  createdAt     DateTime  @default(now())
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ----------------------------------------------------
// REVENUE, INVOICING & EXPENSES (Granular Ledger)
// ----------------------------------------------------

model Invoice {
  id                 String               @id @default(cuid())
  workspaceId        String
  clientId           String?
  invoiceNumber      String               @unique
  subtotal           Decimal              @default(0) @db.Decimal(12, 2)
  tax                Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal              @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal              @default(0) @db.Decimal(12, 2)
  status             InvoiceStatus        @default(DRAFT)
  issuedAt           DateTime             @default(now())
  dueAt              DateTime
  paidAt             DateTime?
  items              Json                 // [{ description, quantity, unitPrice, amount }]
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payments           FinanceTransaction[]

  @@index([workspaceId, status])
  @@index([dueAt])
}

model FinanceTransaction {
  id             String       @id @default(cuid())
  userId         String?
  workspaceId    String?
  clientId       String?
  invoiceId      String?
  idempotencyKey String?      @unique
  type           FinanceType
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  category       String       // Web Dev | Clothing Sale | Art Commission | Tools | Materials
  paymentMethod  String?      // UPI | Bank Transfer | Cash | Card
  description    String?
  occurredAt     DateTime?
  date           DateTime     @default(now())
  recurring      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, date])
  @@index([userId, occurredAt])
}

// ----------------------------------------------------
// JOB APPLICATION TRACKER (User-Level Module)
// ----------------------------------------------------

model JobApplication {
  id               String    @id @default(cuid())
  userId           String
  company          String
  role             String
  jobType          String    @default("REMOTE") // REMOTE | HYBRID | ONSITE
  salaryRange      String?
  location         String?
  source           String?   // LinkedIn | Referral | Career Page | Recruiter
  status           JobStatus @default(APPLIED)
  currentStage     String?
  appliedAt        DateTime  @default(now())
  followUpDeadline DateTime?
  notes            String?
  interviewStages  Json?     // [{ stageName, date, completed, feedback }]
  outcomeDate      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([followUpDeadline])
}

// ----------------------------------------------------
// NOTES & DOCUMENTS
// ----------------------------------------------------

model NoteFolder {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  parentId    String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([workspaceId])
}

model Note {
  id              String         @id @default(cuid())
  userId          String?
  workspaceId     String?
  folderId        String?
  projectId       String?
  clientId        String?
  eventId         String?
  knowledgePageId String?
  title           String
  content         String?
  folder          String?
  tagsList        String[]
  isPinned        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteFolder      NoteFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  event           CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  knowledgePage   KnowledgePage? @relation(fields: [knowledgePageId], references: [id], onDelete: SetNull)
  outgoingLinks   NoteLink[]     @relation("SourceNote")
  incomingLinks   NoteLink[]     @relation("TargetNote")
  files           FileAsset[]
  tags            Tag[]          @relation("NoteTags")

  @@index([workspaceId, isPinned])
  @@index([userId, updatedAt])
}

model NoteLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  createdAt DateTime @default(now())
  source    Note     @relation("SourceNote", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Note     @relation("TargetNote", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model Document {
  id          String        @id @default(cuid())
  userId      String?
  workspaceId String?
  projectId   String?
  clientId    String?
  title       String
  description String?
  folder      String?
  type        String?
  category    String?       // PROPOSAL | AGREEMENT | INVOICE | REQUIREMENT | TEMPLATE | OTHER
  fileUrl     String?
  fileKey     String?
  mimeType    String?
  size        Int?
  content     String?       // Template or record text body
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  files       FileAsset[]
  versions    FileVersion[]
  tags        Tag[]         @relation("DocumentTags")

  @@index([workspaceId, category])
}

model FileAsset {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  taskId     String?
  noteId     String?
  documentId String?
  name       String
  url        String
  mimeType   String?
  size       Int?
  checksum   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note       Note?     @relation(fields: [noteId], references: [id], onDelete: SetNull)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

model FileVersion {
  id         String   @id @default(cuid())
  documentId String
  url        String
  version    Int
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// CALENDAR & REMINDERS
// ----------------------------------------------------

model CalendarEvent {
  id          String              @id @default(cuid())
  userId      String?
  workspaceId String?
  title       String
  description String?
  startsAt    DateTime            @default(now())
  endsAt      DateTime?
  startAt     DateTime?
  endAt       DateTime?
  allDay      Boolean             @default(false)
  location    String?
  color       String?
  recurrence  RecurrenceFrequency @default(NONE)
  reminderAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes       Note[]

  @@index([workspaceId, startsAt])
  @@index([userId, startsAt])
}

// ----------------------------------------------------
// AI ASSISTANT CONVERSATIONS, USAGE & CONFIRMATIONS
// ----------------------------------------------------

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String
  provider  String      // gemini | openai | anthropic
  model     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String         // user | assistant | system | tool
  content        String
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostUsd Decimal  @default(0) @db.Decimal(10, 4)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiConfirmationToken {
  id          String    @id @default(cuid())
  userId      String
  toolName    String
  payloadHash String    // SHA-256 hash of payload
  rawPayload  Json
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ----------------------------------------------------
// KNOWLEDGE, GOALS, HABITS, JOURNAL & COMMUNITY (PRESERVED)
// ----------------------------------------------------

model KnowledgePage {
  id         String          @id @default(cuid())
  userId     String
  parentId   String?
  title      String
  slug       String
  content    String?
  summary    String?
  isFavorite Boolean         @default(false)
  isPinned   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     KnowledgePage?  @relation("KnowledgeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   KnowledgePage[] @relation("KnowledgeHierarchy")
  versions   PageVersion[]
  notes      Note[]
  tags       Tag[]           @relation("KnowledgeTags")

  @@unique([userId, slug])
  @@index([parentId])
}

model PageVersion {
  id              String        @id @default(cuid())
  knowledgePageId String
  content         String
  createdAt       DateTime      @default(now())
  knowledgePage   KnowledgePage @relation(fields: [knowledgePageId], references: [id], onDelete: Cascade)
}

model Idea {
  id             String     @id @default(cuid())
  userId         String
  title          String
  description    String?
  category       String?
  status         WorkStatus @default(IDEA)
  priority       Priority   @default(MEDIUM)
  potentialValue Int?
  relatedProject String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           Tag[]      @relation("IdeaTags")
}

model Goal {
  id           String          @id @default(cuid())
  userId       String
  projectId    String?
  title        String
  description  String?
  period       GoalPeriod
  progress     Int             @default(0)
  targetValue  Int?
  currentValue Int             @default(0)
  startsAt     DateTime?
  dueDate      DateTime?
  status       WorkStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestones   GoalMilestone[]
  tags         Tag[]           @relation("GoalTags")
}

model GoalMilestone {
  id        String    @id @default(cuid())
  goalId    String
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Habit {
  id            String              @id @default(cuid())
  userId        String
  title         String
  description   String?
  frequency     RecurrenceFrequency @default(DAILY)
  currentStreak Int                 @default(0)
  longestStreak Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(false)
  value     Int?
  notes     String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  wins         String?
  problems     String?
  lessons      String?
  ideas        String?
  mood         String?
  tomorrowPlan String?
  summary      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Course {
  id             String         @id @default(cuid())
  userId         String
  title          String
  provider       String?
  category       String?
  progress       Int            @default(0)
  certificateUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItems  LearningItem[]
}

model Resource {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String?
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningItem {
  id          String     @id @default(cuid())
  userId      String
  courseId    String?
  title       String
  description String?
  category    String?
  status      WorkStatus @default(PLANNED)
  progress    Int        @default(0)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tags        Tag[]      @relation("LearningTags")
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  spent     Decimal  @default(0) @db.Decimal(12, 2)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  renewalDate DateTime
  category    String?
  url         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrmLead {
  id           String    @id @default(cuid())
  userId       String
  name         String
  company      String?
  email        String?
  phone        String?
  status       String    @default("Interested")
  value        Decimal?  @db.Decimal(12, 2)
  notes        String?
  nextFollowUp DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model School {
  id             String    @id @default(cuid())
  userId         String
  name           String
  principal      String?
  contactPerson  String?
  email          String?
  phone          String?
  location       String?
  demoStatus     String?
  proposalStatus String?
  followUpAt     DateTime?
  meetingNotes   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NgoProject {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  status        WorkStatus    @default(PLANNED)
  budget        Decimal?      @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  volunteers    Volunteer[]
  beneficiaries Beneficiary[]
}

model Volunteer {
  id           String      @id @default(cuid())
  userId       String
  ngoProjectId String?
  name         String
  email        String?
  phone        String?
  role         String?
  attendance   Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoProject   NgoProject? @relation(fields: [ngoProjectId], references: [id], onDelete: SetNull)
}

model Beneficiary {
  id           String      @id @default(cuid())
  userId       String
  ngoProjectId String?
  name         String
  phone        String?
  location     String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngoProject   NgoProject? @relation(fields: [ngoProjectId], references: [id], onDelete: SetNull)
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  email     String?
  company   String?
  role      String?
  address   String?
  notes     String?
  history   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]    @relation("ContactTags")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  dueAt     DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  taskId    String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  minutes   Int?
  notes     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PomodoroSession {
  id        String    @id @default(cuid())
  userId    String
  minutes   Int
  completed Boolean   @default(false)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id             String          @id @default(cuid())
  userId         String
  name           String
  color          String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]       @relation("ProjectTags")
  tasks          Task[]          @relation("TaskTags")
  knowledgePages KnowledgePage[] @relation("KnowledgeTags")
  notes          Note[]          @relation("NoteTags")
  ideas          Idea[]          @relation("IdeaTags")
  documents      Document[]      @relation("DocumentTags")
  goals          Goal[]          @relation("GoalTags")
  learningItems  LearningItem[]  @relation("LearningTags")
  contacts       Contact[]       @relation("ContactTags")

  @@unique([userId, name])
}
